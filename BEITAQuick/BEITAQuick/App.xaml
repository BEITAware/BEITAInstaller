<Application x:Class="BEITAQuick.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BEITAQuick"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Aero 字体 -->
        <FontFamily x:Key="AeroFont">Segoe UI</FontFamily>

        <!-- Aero 颜色画刷 -->
        <LinearGradientBrush x:Key="AeroGlassBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0F4FA" Offset="0"/>
            <GradientStop Color="#DDE5F0" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="AeroTextBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AeroTitleBrush" Color="#003399"/>
        <SolidColorBrush x:Key="AeroInstructionBrush" Color="#003399"/>
        <SolidColorBrush x:Key="AeroBodyBrush" Color="Black"/>

        <!-- Aero 文本样式 -->
        <Style x:Key="AeroMainInstructionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="18pt"/>
            <Setter Property="Foreground" Value="{StaticResource AeroInstructionBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="AeroBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="13.5pt"/>
            <Setter Property="Foreground" Value="{StaticResource AeroBodyBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Aero 向导页面样式 -->
        <Style x:Key="WizardPageStyle" TargetType="StackPanel">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Aero 按钮样式 -->
        <Style x:Key="AeroButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="113"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="OuterBorder" BorderBrush="#707070" BorderThickness="1" CornerRadius="3" Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="2" Color="White" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="InnerBorder" BorderBrush="White" BorderThickness="1" CornerRadius="2" Margin="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0.5*"/>
                                        <RowDefinition Height="0.5*"/>
                                    </Grid.RowDefinitions>
                                    <!-- 上半部分高光 -->
                                    <Border x:Name="TopHighlight" Grid.Row="0" CornerRadius="1,1,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#F2F2F2" Offset="0"/>
                                                <GradientStop Color="#EBEBEB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- 下半部分阴影 -->
                                    <Border x:Name="BottomShadow" Grid.Row="1" CornerRadius="0,0,1,1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#DDDDDD" Offset="0"/>
                                                <GradientStop Color="#CFCFCF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- 内容（最上层） -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 悬停状态 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#3C7FB1"/>
                                <Setter TargetName="InnerBorder" Property="BorderBrush" Value="#8FFFFFFF"/>
                                <Setter TargetName="TopHighlight" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#EAF6FD" Offset="0"/>
                                            <GradientStop Color="#D9F0FC" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BottomShadow" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#BEE6FD" Offset="0"/>
                                            <GradientStop Color="#A7D9F5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- 按下状态 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#2C628B"/>
                                <Setter TargetName="InnerBorder" Property="BorderBrush" Value="#8FDDDDDD"/>
                                <Setter TargetName="TopHighlight" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E5F4FC" Offset="0"/>
                                            <GradientStop Color="#C4E5F6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BottomShadow" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#98D1EF" Offset="0"/>
                                            <GradientStop Color="#68B3DB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Padding" Value="16,6,14,3"/> <!-- 按下位移效果 -->
                            </Trigger>
                            <!-- 禁用状态 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#ADB2B5"/>
                                <Setter Property="Foreground" Value="#838383"/>
                                <Setter TargetName="TopHighlight" Property="Background" Value="#F4F4F4"/>
                                <Setter TargetName="BottomShadow" Property="Background" Value="#F4F4F4"/>
                            </Trigger>
                            <!-- 默认按钮状态 -->
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#3C7FB1"/>
                                <Setter TargetName="TopHighlight" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#EAF6FD" Offset="0"/>
                                            <GradientStop Color="#D9F0FC" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BottomShadow" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#BEE6FD" Offset="0"/>
                                            <GradientStop Color="#A7D9F5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aero 进度条样式 -->
        <Style x:Key="AeroProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Foreground" Value="#01D328"/>
            <Setter Property="Background" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#BCBCBC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="TemplateRoot">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Rectangle x:Name="PART_Track"/>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="1">
                                <Grid x:Name="Foreground">
                                    <Rectangle x:Name="Indicator" Fill="{TemplateBinding Foreground}" RadiusX="1" RadiusY="1"/>
                                    <Rectangle x:Name="Animation" RadiusX="1" RadiusY="1" Opacity="0.8">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop x:Name="GS1" Color="#00FFFFFF" Offset="-1.0"/>
                                                <GradientStop x:Name="GS2" Color="#40FFFFFF" Offset="-0.7"/>
                                                <GradientStop x:Name="GS3" Color="#80FFFFFF" Offset="-0.5"/>
                                                <GradientStop x:Name="GS4" Color="#40FFFFFF" Offset="-0.3"/>
                                                <GradientStop x:Name="GS5" Color="#00FFFFFF" Offset="0.0"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Grid x:Name="Overlay">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0.5*"/>
                                            <RowDefinition Height="0.5*"/>
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Fill="#40FFFFFF" RadiusX="1" RadiusY="1"/>
                                    </Grid>
                                </Grid>
                            </Decorator>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="GS1" Storyboard.TargetProperty="Offset" From="-1.0" To="2.0" Duration="0:0:1.5"/>
                                            <DoubleAnimation Storyboard.TargetName="GS2" Storyboard.TargetProperty="Offset" From="-0.7" To="2.3" Duration="0:0:1.5"/>
                                            <DoubleAnimation Storyboard.TargetName="GS3" Storyboard.TargetProperty="Offset" From="-0.5" To="2.5" Duration="0:0:1.5"/>
                                            <DoubleAnimation Storyboard.TargetName="GS4" Storyboard.TargetProperty="Offset" From="-0.3" To="2.7" Duration="0:0:1.5"/>
                                            <DoubleAnimation Storyboard.TargetName="GS5" Storyboard.TargetProperty="Offset" From="0.0" To="3.0" Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aero 复选框样式 -->
        <Style x:Key="AeroCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="20" Height="20" Margin="0,0,8,0">
                                <Border x:Name="Border" BorderBrush="#707070" BorderThickness="1" Background="White" CornerRadius="1">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="2" Color="White" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="InnerBorder" BorderBrush="#F4F4F4" BorderThickness="1" Margin="1"/>
                                <Path x:Name="CheckMark" Data="M 1,4 L 4,8 L 10,1" Stroke="#1E1E1E" StrokeThickness="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="IndeterminateMark" Background="#0078D7" Width="11" Height="11" Visibility="Collapsed" CornerRadius="1"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3C7FB1"/>
                                <Setter TargetName="Border" Property="Background" Value="#F3F9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2C628B"/>
                                <Setter TargetName="Border" Property="Background" Value="#D9ECFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>

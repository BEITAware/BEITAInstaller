<Window x:Class="BEITAQuick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BEITAQuick"
        mc:Ignorable="d"
        Title="安装向导" Height="680" Width="1000" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">
    
    <Window.Resources>
        <FontFamily x:Key="AeroFont">Segoe UI</FontFamily>
        
        <Style x:Key="WizardPageStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0"/>
        </Style>
        
        <Style x:Key="AeroMainInstructionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#003399"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        
        <Style x:Key="AeroBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <Style x:Key="AeroCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        
        <Style x:Key="AeroButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="20,5"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        
        <Style x:Key="AeroProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="30"/>
        </Style>
        
        <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AeroFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Content" Value="浏览..."/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容区域 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边图片 -->
            <Border Grid.Column="0" Background="#0078D7">
                <Image Source="Resources/InstallWizardSidePicture.png"
                       Stretch="UniformToFill"
                       VerticalAlignment="Top"/>
            </Border>

            <!-- 内容容器 -->
            <Grid Grid.Column="1" Margin="30">
                
                <!-- 欢迎页面 -->
                <StackPanel x:Name="WelcomePage" Visibility="Visible" Style="{StaticResource WizardPageStyle}">
                    <TextBlock x:Name="WelcomeTitle"
                               Text="欢迎使用安装向导"
                               Style="{StaticResource AeroMainInstructionStyle}"/>
                    <TextBlock x:Name="WelcomeMessage"
                               Style="{StaticResource AeroBodyTextStyle}"
                               Margin="0,0,0,30"/>
                    <TextBlock Text="点击“下一步”继续。"
                               Style="{StaticResource AeroBodyTextStyle}"/>
                </StackPanel>

                <!-- 许可协议页面 -->
                <StackPanel x:Name="LicensePage" Visibility="Collapsed" Style="{StaticResource WizardPageStyle}">
                    <TextBlock Text="许可协议"
                               Style="{StaticResource AeroMainInstructionStyle}"/>
                    <TextBlock Text="请仔细阅读以下许可协议。"
                               Style="{StaticResource AeroBodyTextStyle}"
                               Margin="0,0,0,15"/>
                    <Border BorderBrush="#888888"
                            BorderThickness="1"
                            Background="White"
                            Height="450"
                            Margin="0,0,0,15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <TextBlock x:Name="LicenseText"
                                       TextWrapping="Wrap"
                                       FontFamily="{StaticResource AeroFont}"
                                       FontSize="18"
                                       Foreground="Black"/>
                        </ScrollViewer>
                    </Border>
                    <CheckBox x:Name="AcceptLicense"
                              Content="我接受许可协议中的条款"
                              Style="{StaticResource AeroCheckBoxStyle}"
                              Checked="AcceptLicense_Changed"
                              Unchecked="AcceptLicense_Changed"/>
                </StackPanel>

                <!-- 自定义安装路径页面 -->
                <StackPanel x:Name="CustomPathPage" Visibility="Collapsed" Style="{StaticResource WizardPageStyle}">
                    <TextBlock Text="选择安装位置"
                               Style="{StaticResource AeroMainInstructionStyle}"/>
                    <TextBlock Text="请为每个组件选择安装位置。"
                               Style="{StaticResource AeroBodyTextStyle}"
                               Margin="0,0,0,15"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                        <StackPanel x:Name="PathConfigPanel">
                            <!-- 动态生成的路径配置项 -->
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- 安装进度页面 -->
                <StackPanel x:Name="InstallPage" Visibility="Collapsed" Style="{StaticResource WizardPageStyle}">
                    <TextBlock Text="正在安装"
                               Style="{StaticResource AeroMainInstructionStyle}"/>
                    <TextBlock x:Name="InstallStatusText"
                               Text="准备安装..."
                               Style="{StaticResource AeroBodyTextStyle}"
                               Margin="0,0,0,15"/>
                    <ProgressBar x:Name="InstallProgress"
                                 Style="{StaticResource AeroProgressBarStyle}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="30"
                                 Margin="0,0,0,8"/>
                    <TextBlock x:Name="InstallDetailText"
                               Text=""
                               Style="{StaticResource AeroBodyTextStyle}"
                               Foreground="#666666"/>
                </StackPanel>

                <!-- 完成页面 -->
                <StackPanel x:Name="CompletePage" Visibility="Collapsed" Style="{StaticResource WizardPageStyle}">
                    <TextBlock Text="安装完成"
                               Style="{StaticResource AeroMainInstructionStyle}"/>
                    <TextBlock Text="✓"
                               FontSize="90"
                               Foreground="#009933"
                               HorizontalAlignment="Center"
                               Margin="0,45,0,45"/>
                    <TextBlock x:Name="CompleteMessage"
                               Style="{StaticResource AeroBodyTextStyle}"
                               FontSize="21"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="点击“完成”退出安装向导。"
                               Style="{StaticResource AeroBodyTextStyle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 底部按钮栏 -->
        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#DFDFDF" BorderThickness="0,1,0,0" Padding="23,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton"
                        Content="上一步"
                        Style="{StaticResource AeroButtonStyle}"
                        Click="BackButton_Click"
                        Margin="0,0,15,0"
                        Visibility="Collapsed"/>
                <Button x:Name="NextButton"
                        Content="下一步"
                        Style="{StaticResource AeroButtonStyle}"
                        Click="NextButton_Click"
                        Margin="0,0,15,0"/>
                <Button x:Name="CancelButton"
                        Content="取消"
                        Style="{StaticResource AeroButtonStyle}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
